{
  "name": "mono-interactive",
  "private": true,
  "version": "0.1.0",
  "description": "MONO — an interactive hardware experience built with React and Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-build.mjs",
    "lint": "oxlint --deny-warnings && eslint . --max-warnings 0",
    "test": "node --test",
    "test:browser": "node scripts/browser/run.mjs",
    "preview": "vite preview",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "gsap": "^3.13.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.15.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  }
}
